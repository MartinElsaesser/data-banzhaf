            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--task=mislabel_detect",
                "--dataset=pol",
                "--value_type=Banzhaf_GT",
                "--model_type=MLP",
                "--n_data=200",
                "--n_val=200",
                "--n_repeat=5",
                "--n_sample=100",
                "--batch_size=32",
                "--flip_ratio=0.1",
